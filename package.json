{
  "name": "dovetail",
  "version": "1.0.0",
  "description": "Split large STL files into printable parts with pegs, dowels or dovetails, packed onto plates for Bambu Studio, OrcaSlicer and PrusaSlicer. Runs entirely in the browser.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "3d-printing",
    "stl",
    "3mf",
    "splitter",
    "bambu-studio",
    "orcaslicer",
    "prusaslicer",
    "manifold"
  ],
  "scripts": {
    "test": "tsx test/ops.test.ts && tsx test/autosplit.test.ts && tsx test/connectors.test.ts && tsx test/pack.test.ts && tsx test/slicers.test.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "docs:screenshots": "node scripts/docs/screenshots.mjs",
    "docs:visuals": "tsx scripts/docs/profile.ts && node scripts/docs/render.mjs",
    "demo:model": "tsx scripts/make-demo.ts demo/rook.stl"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "fflate": "^0.8.3",
    "manifold-3d": "^3.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright-core": "^1.49.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^5.4.21"
  }
}
